# The Bean Keeper - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Groq AI Configuration (Required)
GROQ_API_KEY=your_groq_api_key_here

# Existing owner collection and optional guest collection
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_owner_database_id_here
NOTION_TEMPLATE_DATABASE_ID=your_template_database_id_here
# Exact Supabase Auth user UUID permitted to edit the owner collection.
# Set this only after verifying the account in Supabase Authentication → Users.
OWNER_SUPABASE_USER_ID=your_verified_supabase_user_uuid_here

# Configure the Notion OAuth client ID and secret in Supabase Dashboard.
# The Notion integration's callback is https://<project-ref>.supabase.co/auth/v1/callback.

# Supabase Auth (Notion provider)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps API (Optional - for embedded maps)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional analytics and support link (the existing support URL is used by default)
VITE_GA_MEASUREMENT_ID=
VITE_BUY_ME_A_COFFEE_URL=

# Server Configuration
PORT=5001
NODE_ENV=development

# Photo Storage (Replit GCS - for local dev only)
# PRIVATE_OBJECT_DIR=gs://bucket/path

# Cloudinary (Recommended for production - persistent photo storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional operational alert hook for sync/reconcile failures
SYNC_ALERT_WEBHOOK_URL=https://example.com/your-webhook
